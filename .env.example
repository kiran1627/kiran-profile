# Google Gemini API key, used by /api/chat for the AI assistant chatbot.
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API key, used by /api/voice for text-to-speech.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Resend API key, used by /api/contact to deliver contact-form messages.
# Get one free at https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
